<?php

/**
 * @file
 * Provides event deletion/archiving support.
 */

use Drupal\content_moderation\Entity\ContentModerationState;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\date_recur\DateRecurOccurrences;

/**
 * @file
 * Contains localgove_expired_events.module.
 */

/**
 * Implements hook_cron().
 */
function localgov_expired_events_cron(): void {

  // @todo set config default values for expire_days, items_per_cron and action.
  $config = \Drupal::config('localgov_expired_events.settings');
  $noOfDaysToExpire = $config->get('expire_days');
  $items_per_cron = $config->get('items_per_cron');
  $action = $config->get('action');

  try {

    $date = new DrupalDateTime('now', 'UTC');
    $date->modify('midnight');
    // Increase the date by the number of days to expire.
    $date->modify("+$noOfDaysToExpire days");
    // Format the date to match the database format.
    $expiration_date = $date->format('Y-m-d\TH:i:s');

    $database = \Drupal::database();

    // Check that the localgov_event node type exists.
    $node_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('localgov_event');
    if (!$node_type) {
      \Drupal::logger('localgov_expired_events')->error('The localgov_event node type does not exist.');
      return;
    }
    // Check that the localgov_event_date field exists.
    $fieldDefinitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'localgov_event');
    if (!isset($fieldDefinitions['localgov_event_date'])) {
      \Drupal::logger('localgov_expired_events')->error('The localgov_event_date field does not exist on the localgov_event node type.');
      return;
    }
    // Check that the localgov_event_date field is a date_recur field.
    if ($fieldDefinitions['localgov_event_date']->getType() !== 'date_recur') {
      \Drupal::logger('localgov_expired_events')->error('The localgov_event_date field is not a date_recur field.');
      return;
    }

    // Get the table name for the date_recur occurrences.
    $fieldStorageDefinitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
    $occurrenceTableName = DateRecurOccurrences::getOccurrenceCacheStorageTableName($fieldStorageDefinitions['localgov_event_date']);

    // Get the set of events that are ongoing or future.
    $futureEventQuery = $database->select($occurrenceTableName, 'dr')
      ->distinct(TRUE)
      ->fields('dr', ['entity_id'])
      ->where("dr.localgov_event_date_end_value >= '" . $expiration_date . "'");

    // Get the set of events that are expired.
    $pastEventsQuery = $database->select($occurrenceTableName, 'dr2')
      ->distinct(TRUE)
      ->fields('dr2', ['entity_id'])
      ->where("dr2.localgov_event_date_end_value < '" . $expiration_date . "'");

    // Exclude expired events from ongoing or future set of events.
    $pastEventsQuery->condition('dr2.localgov_event_date_end_value', $futureEventQuery, 'AND entity_id NOT IN');

    // join to node_field_data to get only published status.
    $pastEventsQuery->join('node_field_data', 'nfd', 'dr2.entity_id = nfd.nid AND nfd.status = :status', array(':status' => 1));

    if ($items_per_cron > 0) {
      $pastEventsQuery->range(0, $items_per_cron);
    }

    // @todo find a way to get the node_field_data table name dynamically.
    $eventsOnlyInThePast = $pastEventsQuery->execute()->fetchAll();

    // Loop through returned record.
    if (!empty($eventsOnlyInThePast)) {
      foreach ($eventsOnlyInThePast as $record) {
        if (!empty($record->entity_id)) {
          $entity = \Drupal::entityTypeManager()->getStorage('node')->load($record->entity_id);

          // Are we doing a straight delete?
          if ($action == 'delete') {
            $entityToDelete = \Drupal::entityTypeManager()->getStorage('node')->load($record->entity_id);
            $entity->delete();
            \Drupal::logger('localgov_expired_events')->info('The status of event id = ' . $entityToDelete . ' has been deleted.');
          }
          elseif ($action == 'unpublish') {

            // If content moderation is enabled
            // and the entity has a moderation state field.
            // then set the moderation state to 'archived'.
            $moduleHandler = \Drupal::service('module_handler');
            if ($moduleHandler->moduleExists('content_moderation') && $entity->hasField('moderation_state')) {
              $content_moderation_state = ContentModerationState::loadFromModeratedEntity($entity);
              // In workflow terms unpublished equates to archived.
              localgov_expired_events__set_content_state($content_moderation_state, $entity, 'archived');
              \Drupal::logger('localgov_expired_events')->info('The status of event id = ' . $entity->id() . ' has been changed to archived.');
            }
            else {
              // Handle non content moderation update by unpublishing.
              $entity->setUnpublished();
              $entity->save();
              \Drupal::logger('localgov_expired_events')->info('Event id = ' . $entity->id() . ' has been unpublished.');
            }
          }
          else {
            \Drupal::logger('localgov_expired_events')->error('No action has been specified.');
          }
        }
      }
    }
    else {
      \Drupal::logger('localgov_expired_events')->info('No expired events found to process.');
    }

  }
  catch (Exception $e) {
    \Drupal::logger('localgov_expired_events')->error($e->getMessage());
  }
}

/**
 * Helper function to content state.
 */
function localgov_expired_events__set_content_state($content_moderation_state, $entity, $state): void {
  // Check if there is workflow applied on the node.
  // Set the node status to archived.
  if ($content_moderation_state) {
    $workflow = $content_moderation_state->get('workflow')->entity;
    $state_label = $workflow->get('type_settings')['states'];
    if (in_array($state, array_keys($state_label), $strict = TRUE)) {
      $entity->set('moderation_state', 'archived');
      $entity->save();
    }
  }

}
